---
import '../styles/compositions/hero.css';
import type {BuilderPage} from '../page-builder';
import type {HeroProofCase} from '../lib/hero-proof';
import Arrow from './Arrow.astro';
import TermText from './TermText.astro';
import HeroPhoto from './HeroMedia.astro';
interface Props {hero:BuilderPage['hero'];featuredProof?:HeroProofCase;family?:BuilderPage['kind'];demo?:boolean;}
const {hero,featuredProof,family:kind='home',demo=false}=Astro.props;
// Extra Oslo Hero families are presentation-only; the page remains a neutral MWS page.
const family=hero.family??kind;
const image=hero.layout==='centered-none'?undefined:hero.visual.kind==='image'?hero.visual.image:undefined;
const content={family,layout:hero.layout==='centered-none'?'centered':hero.layout,eyebrow:hero.eyebrow??'',title:hero.title,support:hero.support,
 primaryCta:family==='assessment'?undefined:hero.primaryCta,secondaryCta:hero.secondaryCta,titleEmphasis:hero.titleEmphasis,
 visual:image?{kind:'image' as const,image:{...image,kind:(image.kind??'photo') as 'photo'|'illustration',origin:(family==='home'?'home':'page') as 'home'|'page'}}:{kind:'none' as const},
 breadcrumbs:family==='home'||family==='pricing'?[]:[{label:'Forsiden',href:'/'},{label:hero.eyebrow||hero.title}]};
const selectedProof=featuredProof?{metric:featuredProof.metric,comparison:featuredProof.comparison??'',support:featuredProof.displayName+' – '+featuredProof.context}:undefined;
const Heading=demo?'h2':'h1',Section=family==='glossary'?'header':'section';
const inner=['article','assessment','utility'].includes(family),service=family==='service'||family==='index';
const media=content.visual.kind==='image',auxiliary=family==='assessment'&&Astro.slots.has('auxiliary');
const split=content.titleEmphasis==='first-sentence'&&content.title.includes('.')?content.title.indexOf('.')+1:0;
const shellInside=inner;
const classes=['commercial-hero',family==='home'?'home-hero shell':service?'service-hero shell':family==='pricing'?'pricing-hero shell':inner?`inner-hero inner-${family}`:family==='error'?'error-page shell':'glossary-hero'];
const anchor=family==='service'?'service-hero':family==='pricing'?'pricing-hero':undefined;
const centered=content.layout==='centered',left=content.layout==='split-left';
const frameLayout=family==='home'
 ? ['gap-9 min-[1101px]:gap-[88px]',media&&!centered&&(left?'min-[901px]:grid-cols-[1fr_1.15fr]':'min-[901px]:grid-cols-[1.15fr_1fr]')]
 : media?['gap-8 min-[901px]:gap-16',!centered&&(left?'min-[901px]:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)]':'min-[901px]:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]')]
 : auxiliary?['items-start gap-[30px] min-[651px]:gap-[45px] min-[1101px]:gap-[85px]',!centered&&'min-[651px]:grid-cols-2']:[];
---
<Section id={demo?undefined:anchor} class:list={classes} data-hero-family={family} data-hero-layout={content.layout} data-hero-visual={media?'image':auxiliary?'auxiliary':'none'}>
 <div class:list={['hero-container',{shell:shellInside}]}>
  {content.breadcrumbs.length>0&&<nav class="breadcrumbs" aria-label="Brødsmuler">{content.breadcrumbs.map((crumb,index)=><>{index>0&&<span aria-hidden="true">/</span>}{crumb.href?<a href={crumb.href}>{crumb.label}</a>:<span>{crumb.label}</span>}</>)}</nav>}
  <div class="hero place-items-start">
  <div class:list={['hero-content hero-frame w-full p-0 grid-cols-1',inner&&family!=='assessment'?'max-w-[980px]':'max-w-none',centered?'justify-center':'justify-start',frameLayout,{'grid':media||auxiliary,'inner-hero-grid':inner,'assessment-hero-grid':family==='assessment'}]}>
   <div class:list={['page-hero-copy',{'w-full':!centered,'hero-copy':family==='home','service-hero-copy':service&&media}]}>
    <p class="eyebrow">{family==='home'&&<span class="small-dot"></span>}{content.eyebrow}</p>
    <Heading id={!demo&&family==='pricing'?'pricing-title':undefined} class={family==='home'?'hero-title':undefined}>{split?<><span class="hero-emphasis">{content.title.slice(0,split)}</span>{content.title.slice(split)}</>:content.title.split('\n').map((line,index)=><>{index>0&&<br/>}{line}</>)}</Heading>
    <p class={['glossary','error'].includes(family)?'hero-support':'hero-intro'}>{family==='home'?<TermText text={content.support} terms={['seo','ai-synlighet','cro']}/>:content.support}</p>
    {(content.primaryCta||content.secondaryCta)&&<div class={family==='home'||service?'hero-actions':'hero-links'}>{content.primaryCta&&<a class="button btn btn-primary" href={content.primaryCta.href}>{content.primaryCta.label}{family==='error'?<>{' '}<span aria-hidden="true">&#8599;</span></>:<Arrow diagonal/>}</a>}{content.secondaryCta&&<a class="text-link" href={content.secondaryCta.href}>{content.secondaryCta.label}<Arrow/></a>}</div>}
    <slot name="copy-end"/>
   </div>
   {content.visual.kind==='image'&&auxiliary?<div class="hero-aside"><HeroPhoto content={content.visual.image}/><div class="hero-auxiliary"><slot name="auxiliary"/></div></div>:<>
    {content.visual.kind==='image'&&<HeroPhoto content={content.visual.image} proof={selectedProof}/>}
    {auxiliary&&<div class="hero-auxiliary"><slot name="auxiliary"/></div>}
   </>}
  </div>
  </div>
 </div>
</Section>
