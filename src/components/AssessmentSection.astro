---
import '../styles/compositions/assessment.css';
/** Oslo AssessmentSection markup with MWS' opt-in, approved Lead Intake slot.
 * Never publish an inert/unauthorized lead form. */
import Arrow from './Arrow.astro';
interface Props {id:string;eyebrow?:string;heading:string;body?:readonly string[];
items?:readonly {title:string;text:string}[];links?:readonly {label:string;href:string}[];}
const {id,eyebrow,heading,body=[],items=[],links=[]}=Astro.props;
if(!Astro.slots.has('form'))throw new Error('Assessment requires an approved Lead Intake form in slot="form"');
---
<section id={id} class="assessment-section section-space bg-info text-info-content"><div class="shell standalone-assessment-grid"><div class="assessment-copy"><p class="eyebrow">{eyebrow}</p><h2>{heading}</h2>{body.map(text=><p>{text}</p>)}<div class="form-process">{items.map(item=><div><h3>{item.title}</h3><p>{item.text}</p></div>)}</div><div class="section-links">{links.map(link=><a class="text-link" href={link.href}>{link.label}<Arrow /></a>)}</div></div><slot name="form"/></div></section>
