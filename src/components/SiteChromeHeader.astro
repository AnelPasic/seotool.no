---
import '../styles/header-navigation.css';
import type { SiteChrome } from '../lib/site-chrome';
import { siteChromeSchema } from '../lib/site-chrome';
import { resolveSiteChromeLogos } from '../lib/site-chrome-logos';
import SiteChromeNav from './SiteChromeNav.astro';
import SiteChromeThemeSwitch from './SiteChromeThemeSwitch.astro';
import SiteChromeLanguages from './SiteChromeLanguages.astro';
import SiteChromeSearch from './SiteChromeSearch.astro';
import Arrow from './Arrow.astro';

interface Props { config: SiteChrome; instanceId?: string; }
const { config: input, instanceId = 'site' } = Astro.props;
const config = siteChromeSchema.parse(input);
const mobileId = 'mws-' + instanceId + '-mobile-nav';
const options = config.headerOptions;
const logos = resolveSiteChromeLogos(config);
const hasLogo = Boolean(logos.desktopLight || logos.desktopDark);
const hasMobileLogo = Boolean(logos.mobileLight || logos.mobileDark);
const ctaClasses = {
  primary:'btn-primary', secondary:'btn-secondary', accent:'btn-accent',
  neutral:'btn-neutral', info:'btn-info', success:'btn-success',
  warning:'btn-warning', error:'btn-error',
} as const;
const ctaClass = config.primaryCta ? ctaClasses[config.primaryCta.variant] : '';
---
<a class="skip-link" href="#main">{config.skipLabel}</a>
<header class:list={['site-header', {'site-header--sticky': options.sticky}]} data-mws-chrome-header>
  <div class="shell header-inner navbar">
    <a href={config.brand.homeHref} class:list={['wordmark', {'wordmark--has-mobile-logo': hasMobileLogo}]} aria-label={config.brand.name}>
      {hasLogo
        ? <span class="site-brand-image-pair site-brand-image-pair--header" aria-hidden="true">
            <img class="site-brand-image site-brand-image--light" src={logos.desktopLight??logos.desktopDark} alt="" width="176" height="42" />
            <img class="site-brand-image site-brand-image--dark" src={logos.desktopDark??logos.desktopLight} alt="" width="176" height="42" />
          </span>
        : <span>{config.brand.name}</span>}
      {hasMobileLogo && <span class="site-brand-image-pair site-brand-image-pair--mobile" aria-hidden="true">
        <img class="site-brand-image site-brand-image--light" src={logos.mobileLight??logos.mobileDark} alt="" width="58" height="42" />
        <img class="site-brand-image site-brand-image--dark" src={logos.mobileDark??logos.mobileLight} alt="" width="58" height="42" />
      </span>}
    </a>
    <nav class="desktop-nav" aria-label={config.navigationLabel}>
      <SiteChromeNav items={config.navigation} placement="desktop" instanceId={instanceId} />
    </nav>
    <div class="header-actions">
      {options.showSearch && config.search && <SiteChromeSearch search={config.search} placement="desktop" />}
      {options.showThemeSwitch && <SiteChromeThemeSwitch themes={config.themes} placement="desktop" />}
      {options.showLanguageSwitch && config.languages.length>0 && <SiteChromeLanguages languages={config.languages} placement="desktop" />}
      {config.utilityLinks.map(link => <a href={link.href}>{link.label}</a>)}
      {options.showCta && config.primaryCta && <a href={config.primaryCta.href}
        class:list={['button','button-small','btn','btn-sm',ctaClass]}>
        {config.primaryCta.label}<Arrow diagonal />
      </a>}
      <button class="menu-toggle" type="button" data-mws-mobile-toggle
        aria-expanded="false" aria-controls={mobileId} aria-label={config.openMenuLabel} data-home-menu
        data-open-label={config.openMenuLabel} data-close-label={config.closeMenuLabel}><span></span><span></span></button>
    </div>
  </div>
  <nav id={mobileId} class="mobile-menu shell" data-mws-mobile-nav aria-label={config.mobileNavigationLabel} hidden>
    <SiteChromeNav items={config.navigation} placement="mobile" instanceId={instanceId} />
    {options.showSearch && config.search && <SiteChromeSearch search={config.search} placement="mobile" />}
    {options.showThemeSwitch && <SiteChromeThemeSwitch themes={config.themes} placement="mobile" />}
    {options.showLanguageSwitch && config.languages.length>0 && <SiteChromeLanguages languages={config.languages} placement="mobile" />}
  </nav>
</header>
<script>
  import { mountSiteChromeHeaders } from '../lib/site-chrome-interactions';
  import { mountChromeThemeSwitchers } from '../lib/site-chrome-theme-interactions';
  function mountChrome() { mountSiteChromeHeaders(); mountChromeThemeSwitchers(); }
  mountChrome();
  document.addEventListener('astro:page-load', mountChrome);
</script>
